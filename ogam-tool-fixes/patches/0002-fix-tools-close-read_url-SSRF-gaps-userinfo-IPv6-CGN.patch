+ */
+import { isPrivateUrl } from '../../../../src/services/tools/privateUrl';
+
+describe('isPrivateUrl', () => {
+  it.each([
+    'http://localhost:8080/',
+    'http://127.0.0.1/',
+    'http://10.1.2.3/',
+    'http://172.31.255.255/',
+    'http://192.168.0.1/',
+    'http://169.254.169.254/latest/meta-data/',
+    'http://100.64.0.1/',
+    'http://100.127.255.254/',
+    'http://0.0.0.0/',
+    'http://user:pass@10.0.0.1/',
+    'http://example.com@127.0.0.1/',
+    'http://2130706433/',
+    'http://0x7f.0.0.1/',
+    'http://[::1]/',
+    'http://[::]/',
+    'http://[fd00::1]/',
+    'http://[fe80::1]/',
+    'http://[::ffff:127.0.0.1]/',
+    'http://[::ffff:a9fe:a9fe]/',
+    'http://metadata.google.internal/',
+    'http://printer.local/',
+    'http://app.localhost/',
+    'http://nas/',
+    'file:///etc/passwd',
+    'ftp://example.com/',
