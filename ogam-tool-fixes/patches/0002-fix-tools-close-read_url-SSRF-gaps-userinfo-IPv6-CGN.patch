+  ])('blocks %s', url => {
+    expect(isPrivateUrl(url)).toBe(true);
+  });
+
+  it.each([
+    'https://example.com/',
+    'https://user@example.com/',
+    'http://100.63.255.255/',
+    'http://100.128.0.1/',
+    'http://172.15.0.1/',
+    'http://172.32.0.1/',
+    'https://8.8.8.8/',
+    'https://[2606:4700:4700::1111]/',
+    'https://localhost.example.com/',
+  ])('allows %s', url => {
+    expect(isPrivateUrl(url)).toBe(false);
+  });
+});
