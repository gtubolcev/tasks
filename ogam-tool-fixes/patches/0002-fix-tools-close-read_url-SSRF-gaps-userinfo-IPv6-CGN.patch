+/**
+ * SSRF guard for tools that fetch a URL the model chose (read_url).
+ *
+ * The host is taken from the URL parser, never from a regex on the raw string: a regex
+ * reading "everything after //" sees `user` in `http://user@10.0.0.1/` and lets a private
+ * host through. The WHATWG parser (react-native-url-polyfill) also normalises the
+ * shorthand IPv4 forms (`http://2130706433/`, `http://0x7f.1/`) to dotted quads.
+ */
+
+const BLOCKED_HOSTS = new Set([
+  'localhost',
+  'metadata.google.internal',
+  'metadata.goog',
+  'metadata.azure.com',
+  'instance-data',
+]);
+
+const BLOCKED_SUFFIXES = ['.localhost', '.local', '.internal', '.lan', '.home.arpa'];
+
+function ipv4Octets(host: string): number[] | null {
+  const parts = host.split('.');
+  if (parts.length !== 4 || !parts.every(p => /^\d{1,3}$/.test(p))) return null;
+  const octets = parts.map(Number);
+  return octets.every(o => o <= 255) ? octets : null;
+}
+
+function isPrivateIpv4([a, b]: number[]): boolean {
+  return a === 0                                // "this network"
+    || a === 10                                 // RFC 1918
+    || a === 127                                // loopback
+    || (a === 100 && b >= 64 && b <= 127)       // CGNAT / Tailscale (100.64.0.0/10)
+    || (a === 169 && b === 254)                 // link-local, cloud metadata
+    || (a === 172 && b >= 16 && b <= 31)        // RFC 1918
+    || (a === 192 && b === 168)                 // RFC 1918
+    || (a === 198 && (b === 18 || b === 19))    // benchmarking (198.18.0.0/15)
+    || a >= 224;                                // multicast, reserved, broadcast
+}
+
+/** `::ffff:7f00:1` / `::ffff:127.0.0.1` → [127, 0, 0, 1]; anything else → null. */
+function ipv4FromMappedIpv6(host: string): number[] | null {
+  const m = /^(?:0{0,4}:){0,5}:?ffff:(.+)$/i.exec(host);
+  if (!m) return null;
+  const tail = m[1];
+  const dotted = ipv4Octets(tail);
+  if (dotted) return dotted;
+  const hex = /^([0-9a-f]{1,4}):([0-9a-f]{1,4})$/i.exec(tail);
+  if (!hex) return null;
+  const hi = parseInt(hex[1], 16);
+  const lo = parseInt(hex[2], 16);
+  return [hi >> 8, hi & 0xff, lo >> 8, lo & 0xff];
+}
+
+function isPrivateIpv6(host: string): boolean {
+  const h = host.toLowerCase();
+  if (h === '::' || h === '::1') return true;              // unspecified, loopback
+  const mapped = ipv4FromMappedIpv6(h);
+  if (mapped) return isPrivateIpv4(mapped);
+  const first = parseInt(h.split(':')[0] || '0', 16);
+  return (first & 0xfe00) === 0xfc00                       // unique local fc00::/7
+    || (first & 0xffc0) === 0xfe80                         // link-local fe80::/10
+    || (first & 0xff00) === 0xff00;                        // multicast ff00::/8
+}
+
+/**
+ * True when the URL must not be fetched: unparsable, not http(s), or pointing at
+ * loopback / private / link-local / CGNAT / cloud-metadata / local-only names.
+ */
+export function isPrivateUrl(url: string): boolean {
+  let parsed: URL;
+  try {
+    parsed = new URL(url);
+  } catch {
+    return true;
+  }
+  if (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') return true;
+
+  const host = parsed.hostname.toLowerCase().replace(/^\[|\]$/g, '').replace(/\.$/, '');
+  if (!host) return true;
+  if (BLOCKED_HOSTS.has(host) || BLOCKED_SUFFIXES.some(s => host.endsWith(s))) return true;
+  if (host.includes(':')) return isPrivateIpv6(host);
+  const octets = ipv4Octets(host);
+  if (octets) return isPrivateIpv4(octets);
+  // A single-label name (no dot) only resolves on the local network ("router", "nas").
+  return !host.includes('.');
+}
