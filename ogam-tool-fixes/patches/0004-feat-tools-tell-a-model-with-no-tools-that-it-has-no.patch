+  describe('buildPromptWithToolNote', () => {
+    it('tells a model with no tools at all that it has none', () => {
+      const prompt = buildPromptWithToolNote('Base.', { activeToolIds: [], useTextHint: false, hasExtensionTools: false });
+      expect(prompt).toBe(`Base.${NO_TOOLS_NOTE}`);
+    });
+
+    it('adds no note when only MCP/extension tools are enabled', () => {
+      const prompt = buildPromptWithToolNote('Base.', { activeToolIds: [], useTextHint: false, hasExtensionTools: true });
+      expect(prompt).toBe('Base.');
+    });
+
+    it('adds nothing when native tool calling carries the tools', () => {
+      const prompt = buildPromptWithToolNote('Base.', { activeToolIds: ['calculator'], useTextHint: false, hasExtensionTools: false });
+      expect(prompt).toBe('Base.');
+    });
+
+    it('adds the text hint, not the note, when the engine lacks native tool calling', () => {
+      const prompt = buildPromptWithToolNote('Base.', { activeToolIds: ['calculator'], useTextHint: true, hasExtensionTools: false });
+      expect(prompt).toBe(`Base.${buildToolSystemPromptHint(['calculator'])}`);
+      expect(prompt).not.toContain(NO_TOOLS_NOTE);
+    });
+  });
 });
