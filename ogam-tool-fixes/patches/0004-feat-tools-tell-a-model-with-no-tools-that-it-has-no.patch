diff --git a/src/services/tools/registry.ts b/src/services/tools/registry.ts
index 85d43506b..52f02d577 100644
--- a/src/services/tools/registry.ts
+++ b/src/services/tools/registry.ts
@@ -168,3 +168,26 @@ export function buildToolSystemPromptHint(enabledToolIds: string[]): string {
   const toolList = enabledTools.map(t => `- ${t.name}: ${t.description}`).join('\n');
   return `\n\nTools available:\n${toolList}\nUse these tools proactively and precisely — call the right tool at the right moment rather than guessing or saying you cannot help.`;
 }
+
+/**
+ * One sentence for a turn where the model has no tools at all. Without it a tool-less model
+ * answers "run this" / "what can you do" from training priors and claims it ran code or made
+ * a plot. Kept to one sentence: small local models can have a 4k context.
+ */
+export const NO_TOOLS_NOTE =
+  '\n\nYou have no tools in this chat: you cannot run code, browse, or read files. Do not pretend to; give code or steps for the user to run instead.';
+
+/**
+ * The system prompt's tool line for this turn: the built-in tools text hint when the engine
+ * lacks native tool calling, the no-tools note when the model gets no tools at all, otherwise
+ * nothing (native schemas carry the tools; MCP/extension hints are added by the tool loop).
+ * `hasExtensionTools` counts MCP/extension tools, which are not in activeToolIds.
+ */
+export function buildPromptWithToolNote(
+  basePrompt: string,
+  opts: { activeToolIds: string[]; useTextHint: boolean; hasExtensionTools: boolean },
+): string {
+  if (opts.useTextHint) return `${basePrompt}${buildToolSystemPromptHint(opts.activeToolIds)}`;
+  if (opts.activeToolIds.length === 0 && !opts.hasExtensionTools) return `${basePrompt}${NO_TOOLS_NOTE}`;
+  return basePrompt;
+}
