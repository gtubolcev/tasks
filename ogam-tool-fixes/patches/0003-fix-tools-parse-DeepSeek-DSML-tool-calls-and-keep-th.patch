+    expect(result.toolCalls).toHaveLength(1);
+    expect(result.toolCalls[0].name).toBe('web_search');
+    expect(result.toolCalls[0].arguments).toEqual({ query: 'weather Paris' });
+    expect(result.cleanText).toBe('Let me look.');
+  });
+
+  it('accepts the doubled-bar DSML spelling', () => {
+    const result = parse('<｜｜DSML｜｜invoke name="read_url"><｜｜DSML｜｜parameter name="url">https://x.com</｜｜DSML｜｜parameter></｜｜DSML｜｜invoke>');
+    expect(result.toolCalls[0]).toMatchObject({ name: 'read_url', arguments: { url: 'https://x.com' } });
+    expect(result.cleanText).toBe('');
+  });
