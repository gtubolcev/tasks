+      '<｜DSML｜invoke name="web_search">\n' +
+      '<｜DSML｜parameter name="query" string="true">weather Paris</｜DSML｜parameter>\n' +
+      '</｜DSML｜invoke>\n</｜DSML｜function_calls>';
