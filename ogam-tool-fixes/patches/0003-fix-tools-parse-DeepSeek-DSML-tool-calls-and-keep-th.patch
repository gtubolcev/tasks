diff --git a/src/utils/messageContent.ts b/src/utils/messageContent.ts
index 8dd5c166f..af9b67594 100644
--- a/src/utils/messageContent.ts
+++ b/src/utils/messageContent.ts
@@ -55,6 +55,29 @@ const XML_TOOL_CALL_BLOCK_PATTERN = new RegExp(
   'gi',
 );
 
+// DeepSeek (V3.2+) wraps its native tool-call tags in a DSML special token written with
+// fullwidth vertical bars: `<｜DSML｜function_calls><｜DSML｜invoke name="f"><｜DSML｜parameter
+// name="k" string="true">v</｜DSML｜parameter></｜DSML｜invoke></｜DSML｜function_calls>`.
+// When a server does not parse them (or the tools were dropped for a final answer) they
+// reach the text verbatim.
+const DSML_MARKER_PATTERN = /｜{1,2}DSML｜{1,2}/g;
+const DSML_BLOCK_PATTERN =
+  /<｜{1,2}DSML｜{1,2}(function_calls|tool_calls|invoke)\b[\s\S]*?<\/｜{1,2}DSML｜{1,2}\1>\s*/g;
+const DSML_STRAY_TAG_PATTERN = /<\/?｜{1,2}DSML｜{1,2}[^>]*>\s*/g;
+
+/** Whether text carries DeepSeek DSML tool-call markup. */
+export function hasDsmlMarkup(text: string): boolean {
+  return text.includes('DSML｜');
+}
+
+/** Reduce DSML-wrapped tags to the plain `<invoke>` / `<parameter>` forms the text parser reads. */
+export function normalizeDsmlToolCalls(text: string): string {
+  if (!hasDsmlMarkup(text)) return text;
+  return text
+    .replace(DSML_MARKER_PATTERN, '')
+    .replace(/<\/?(?:function_calls|tool_calls)>\s*/g, '');
+}
+
 /**
  * Length of the longest suffix of `text` that is a PREFIX of `tag` — i.e. how much of a possibly-
  * incomplete tag is dangling at the end of a stream chunk, so the incremental parsers can hold it
@@ -80,6 +103,9 @@ const CONTROL_TOKEN_PATTERNS: RegExp[] = [
   ...TOOL_CALL_BLOCK_PATTERNS,
   // XML-style `<function=…>…</function>` tool-call blocks (the extractor's second grammar).
   XML_TOOL_CALL_BLOCK_PATTERN,
+  // DeepSeek DSML tool-call blocks, then any stray DSML tag left by a truncated block.
+  DSML_BLOCK_PATTERN,
+  DSML_STRAY_TAG_PATTERN,
   // Gemma 4 string-delimiter token that may appear outside a tool block
   /<\|">/g,
 ];
